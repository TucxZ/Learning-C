    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="c, t" type="Real" array="False" size=""/>
            <output expression="&quot;Qual o tamanho do circulo&quot;" newline="True"/>
            <input variable="t"/>
            <for variable="c" start="1" end="360" direction="inc" step="1">
                <turn expression="1" rotate="right"/>
                <forward expression="t" pen="down"/>
            </for>
        </body>
